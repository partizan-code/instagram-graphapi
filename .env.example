# Unified Login: the working System User Token from Graph API Explorer.
META_ACCESS_TOKEN=
META_API_VERSION=v27.0
# Explicit choice when multiple accounts are assigned; never the system-user ID.
INSTAGRAM_ACCOUNT_ID=

# Only needed when obtaining or refreshing tokens from Python.
# Use the Meta app credentials, not the former Instagram app credentials.
APP_ID=
APP_SECRET=
META_CONFIG_ID=
REDIRECT_URI=https://localhost/
